[Unit]
Description=Temperature-controlled RGB lighting
Wants=openrgb-local.service
After=openrgb-local.service
StartLimitIntervalSec=0

[Service]
Type=simple
Nice=19
IOSchedulingClass=idle
CPUWeight=1
IOWeight=1
ExecStart=%h/.local/share/thermal-rgb/.venv/bin/python -u %h/.local/share/thermal-rgb/thermal_rgb.py
Restart=on-failure
RestartSec=7

[Install]
WantedBy=default.target
