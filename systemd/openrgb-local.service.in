[Unit]
Description=OpenRGB hardware controller (SDK on localhost)
Documentation=https://openrgb.org/
StartLimitIntervalSec=0

[Service]
Type=simple
Nice=19
IOSchedulingClass=idle
CPUWeight=1
IOWeight=1
Environment=QT_QPA_PLATFORM=offscreen
ExecStart=@OPENRGB_BINARY@ --server --noautoconnect --server-host 127.0.0.1 --server-port @OPENRGB_PORT@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
